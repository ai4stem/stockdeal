# === App ===
APP_ENV=dev                  # dev | prod
TZ=Asia/Seoul
LOG_LEVEL=INFO
DAILY_REPORT_HOUR=22
TRADING_MODE=SIMULATION      # OFF | SIMULATION | CONFIRM | AUTO

# === KIS (한국투자증권) ===
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_ENV=prod                 # prod | paper

# === Anthropic (Claude) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-4-6
CLAUDE_MODEL_DEEP=claude-opus-4-7

# === Open DART ===
DART_API_KEY=

# === News ===
FINNHUB_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === Notification: Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Notification: Kakao (나에게 보내기) ===
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

# === Notification: Email (Gmail SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
TO_EMAIL=

# === Database (MySQL) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stockdeal
DB_PASSWORD=
DB_DATABASE=stockdeal

# === Watchlist (comma-separated KRX tickers) ===
# 005930=삼성전자, 000660=SK하이닉스, 222800=심텍, 403870=HPSP,
# 005290=동진쎄미켐, 442900=씨엠티엑스
WATCHLIST=403870,005930,000660,222800,005290,442900
PRIMARY_TICKER=403870

# === Risk limits ===
DAILY_ORDER_BUDGET_RATIO=0.05
MAX_POSITION_RATIO=0.20
ORDER_CONFIRM_TIMEOUT_SEC=600
